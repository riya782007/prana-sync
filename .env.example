# =============================================================================
# Prana Sync environment variables
# Copy this file to `.env.local` and fill in the keys you have.
# EVERY feature works WITHOUT keys (simulated data). Add keys to go live.
# =============================================================================

# --- LLM: Google Gemini (PRIMARY) --------------------------------------------
# Free tier via Google AI Studio, no credit card. Powers skin photo analysis
# and ingredient-label OCR (one multimodal model does both).
# Get it: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override. Defaults to gemini-2.5-flash.
# Use gemini-2.5-flash-lite for the highest free-tier request volume.
GEMINI_MODEL=gemini-2.5-flash

# --- LLM: Groq (OPTIONAL fast text fallback) ---------------------------------
# Free tier, no billing. Very fast Llama inference for text-only generation.
# Get it: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Air Quality: WAQI / aqicn (FREE token) ----------------------------------
# Live AQI by city/station. Without it, the app uses simulated AQI values.
# Get it: https://aqicn.org/data-platform/token/
WAQI_TOKEN=

# --- Quick commerce affiliate attribution (OPTIONAL) -------------------------
# Appended to reorder deep links once you sign an affiliate deal.
AFFILIATE_TAG=

# --- Database / Auth (Phase 2 — not required for the demo) -------------------
# Supabase free tier: Postgres + Auth + storage.
# Get it: https://supabase.com  (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Phase 3 — monetization) ---------------------------------------
# Razorpay for INR subscriptions / UPI. No upfront cost; transaction-based.
# Get it: https://dashboard.razorpay.com  (Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
